{
  "name": "on-call-autopilot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Backend-first autonomous incident recovery orchestrator guarding an external service.",
  "scripts": {
    "dev": "convex dev",
    "agent:worker": "node --env-file=.env.local scripts/agent-worker.mjs",
    "deploy": "convex deploy",
    "seed": "convex run seed:defaults",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run tests/evals.test.ts tests/evaluation-runner.test.ts",
    "validate:skill": "node scripts/validate-skill.mjs",
    "check": "npm run typecheck && npm test && npm run validate:skill"
  },
  "dependencies": {
    "convex": "^1.25.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.15.30",
    "convex-test": "^0.0.54",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=20"
  }
}
